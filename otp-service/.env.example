# OTP service configuration.

# Supabase project holding the bank_otps table (the OPS project).
# MUST be a service-role key. The VITE_SUPABASE_PUBLISHABLE_KEY fallback was
# removed: that key ships to browsers, and with it live OTP codes were readable
# by anything holding it. Run scripts/sql/bank_otps_hardening.sql too.
SUPABASE_URL=https://your_supabase_project_id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Shared secret with the backend. REQUIRED - the service refuses to start
# without it, because /generate can send WhatsApp messages to any number and
# /verify is a brute-force oracle. Must match OTP_SERVICE_SHARED_SECRET in the
# backend's .env.
OTP_SERVICE_SHARED_SECRET=generate_a_long_random_string

# 6 digits by default: a 4-digit code is a 9,000-value space, trivially
# brute-forced inside the 5-minute expiry window.
OTP_CODE_LENGTH=6
OTP_MAX_VERIFY_ATTEMPTS=5

# WhatsApp number used to deliver codes.
SECURITY_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
SECURITY_WHATSAPP_ACCESS_TOKEN=your_access_token

USE_NGROK=false
