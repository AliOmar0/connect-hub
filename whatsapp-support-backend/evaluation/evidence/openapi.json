  "openapi": "3.1.0",
  "info": {
    "title": "PIB Support — AI/Policy API",
    "description": "AI / policy surface of the PIB support backend.\n\nAuthentication: these endpoints are internal service endpoints intended to run\nbehind the API gateway / private network. They do not require a per-request\ntoken today; the public WhatsApp/Twilio webhooks (not included in this AI\nsnapshot) are authenticated via provider signature verification. Add a gateway\nAPI key before exposing publicly.\n\nErrors: 422 is returned for malformed request bodies (FastAPI validation); 500\nfor model/backend failures. Decision outputs are strongly typed (see\nActionDecision and the response schemas).",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/nlp/analyze": {
      "post": {
        "tags": ["nlp"],
        "summary": "Analyze",
        "description": "Analyse a message into a masked, confidence-scored NLP result.",
        "operationId": "analyze_api_v1_nlp_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/nlp/labels": {
      "get": {
        "tags": ["nlp"],
        "summary": "Labels",
        "description": "Return the canonical label sets used by the pipeline.",
        "operationId": "labels_api_v1_nlp_labels_get",
