# Supabase Configuration
SUPABASE_URL=https://your_supabase_project_id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
# Required at startup (_validate_startup in app/main.py) - must match the
# Node.js API's JWT_SECRET / SUPABASE_JWT_SECRET since both backends verify
# the same Supabase-issued access tokens.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# "Bank_db_oss" - separate Supabase project holding the bank's customers/
# accounts tables, used to answer customer account questions after OTP
# verification. Reached ONLY through the get_bank_account_by_phone RPC.
#
# There is NO fallback to SUPABASE_URL/SUPABASE_KEY. When these are unset the
# feature is simply off; bank data is never served from the main project.
#
# BANK_DB_OSS_KEY MUST be the bank project's PUBLISHABLE (anon) key, never a
# service-role key: service_role bypasses RLS, which would defeat the read-only
# grants. The app refuses to start if it detects a service-role key here.
#
# Before first use, run BOTH scripts (see scripts/sql/):
#   scripts/sql/bank_otps_hardening.sql   -> in the OPS project (this one)
#   scripts/sql/bank_db_oss_readonly.sql  -> in the BANK project
BANK_DB_OSS_URL=https://your_bank_db_oss_project_id.supabase.co
BANK_DB_OSS_KEY=your_bank_db_oss_publishable_key

# Set false to run the assistant without account lookups. When true, the server
# refuses to start unless Bank_db_oss AND the OTP service are both configured.
BANK_LOOKUP_ENABLED=true

# OTP service (otp-service/). The backend never receives the code itself - it
# asks /generate to send one and /verify to check what the customer typed.
OTP_SERVICE_BASE_URL=https://your_otp_service_host
# Shared secret required by BOTH sides. The OTP service refuses to start without
# it, because /generate can text any number and /verify is a brute-force oracle.
OTP_SERVICE_SHARED_SECRET=generate_a_long_random_string
OTP_CODE_LENGTH=6
OTP_MAX_ATTEMPTS=3
OTP_SESSION_TTL_SECONDS=300

# CORS: comma-separated list of allowed browser origins. Leave empty to block
# all cross-origin browser requests (server-to-server calls are unaffected).
BACKEND_CORS_ORIGINS=http://localhost:5173

# Rate limiting (NFR-03.03)
RATE_LIMIT_IP_PER_MIN=60
RATE_LIMIT_SESSION_PER_MIN=10
# Enable ONLY when a proxy you control (Render/Vercel/nginx) sits in front.
# When false, X-Forwarded-For is ignored, since any client can forge it and
# thereby bypass per-IP limiting entirely.
TRUST_PROXY_HEADERS=false

# Data retention (NFR-03.05) - days to keep completed/missed sessions before
# they are permanently purged by the retention_cleanup_task.
DATA_RETENTION_DAYS=30

# WhatsApp (Optional - logic will fallback to api_configurations table)
# No default any more: a verify token shipped in source is a token everyone knows.
WHATSAPP_VERIFY_TOKEN=your_verify_token

# Meta App Secret - used to verify X-Hub-Signature-256 on inbound webhooks.
# Signature verification now FAILS CLOSED: if this is unset, inbound webhooks
# are REJECTED rather than accepted with a warning.
WHATSAPP_APP_SECRET=your_meta_app_secret

# Local dev / simulator escape hatch: accept unsigned webhooks when no app
# secret is configured. Never enable in production.
WHATSAPP_ALLOW_UNSIGNED=false

# Voice STT for WhatsApp voice notes (Deepgram via REST; no local model needed).
DEEPGRAM_API_KEY=your_deepgram_api_key
VOICE_ASR_MODEL=nova-3
VOICE_ASR_LANGUAGE=ar

# AI reply latency: debounce window (seconds) before buffered messages go to the
# LLM. Lower = faster replies. The timer resets on each new message, so rapid
# bursts are still combined into a single AI request.
BUFFER_WAIT_SECONDS=4
RAPID_TYPING_WAIT_SECONDS=7

# OpenRouter (fallback model provider)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=arcee-ai/trinity-large-preview:free

# DeepSeek (PRIMARY answering model). When set, the assistant answers via DeepSeek
# and OpenRouter is used only as a fallback. DeepSeek's API is OpenAI-compatible.
# Models: deepseek-v4-pro (reasoning, highest quality) or deepseek-v4-flash (faster).
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-pro

# Ngrok
ID=your_ngrok_auth_token
URL=your-subdomain.ngrok-free.dev
USE_NGROK=true
