# =============================================================================
# Connect-Hub environment template
# Copy to `.env` and fill in real values. NEVER commit a real .env file.
# All values below are placeholders. Rotate any credential that was ever
# committed to git history.
# =============================================================================

# --- Supabase (Frontend / public) ---
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# --- Supabase (Server-side, secret) ---
# JWT secret used to verify Supabase access tokens server-side (Project Settings > API > JWT Secret)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
# Service-role key for privileged server operations (NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Twilio (Voice / SMS) ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_API_KEY="SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_API_SECRET="your-twilio-api-secret"
TWIML_APP_SID="APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+10000000000"

# Public base URL used by Twilio to reach this server (e.g. ngrok or prod URL)
NGROK_URL="https://your-subdomain.example.dev"

# --- ngrok per-channel tunnels (used by `npm run channel:whatsapp` / `channel:voice`) ---
# Each laptop uses its OWN authtoken + its OWN reserved domain (free ngrok = one
# static domain per account, one tunnel at a time). Set only the domain for the
# channel that laptop runs.
NGROK_AUTHTOKEN="your_ngrok_authtoken"
WHATSAPP_NGROK_URL="your-whatsapp-domain.ngrok-free.dev"
VOICE_NGROK_URL="your-voice-domain.ngrok-free.dev"
# Set to "true" in production to reject Twilio webhooks without a valid signature
TWILIO_VALIDATE_SIGNATURE="true"

# --- AI / Speech Services ---
OPENROUTER_API_KEY="sk-or-your-openrouter-key"
OPENROUTER_MODEL="google/gemma-4-31b-it:free"
# Optional comma-separated fallback models (OpenRouter auto-fails-over; max 3 total).
OPENROUTER_FALLBACK_MODELS="meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-next-80b-a3b-instruct:free"
DEEPGRAM_API_KEY="your-deepgram-key"
ELEVENLABS_API_KEY="your-elevenlabs-key"
MUNSIT_API_KEY="your-munsit-key"

# --- Local Services ---
PIPER_URL="http://localhost:5000"
PORT=3001
TWILIO_SERVER_PORT=3001
VITE_BACKEND_URL="http://localhost:3001"
# Frontend → Node voice/API server (signed media URLs, etc.)
VITE_NODE_API_URL="http://localhost:3001"
# Frontend → Knowledge-base admin API (Person 1's backend contract)
VITE_KB_API_URL="http://localhost:5000/api/v1/kb"
# Escalation SLA windows (seconds): business hours vs out-of-hours
VITE_SLA_BUSINESS_SECONDS=120
VITE_SLA_OUT_OF_HOURS_SECONDS=600

# --- Security WhatsApp (OTP delivery) ---
SECURITY_WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WhatsApp_Business_Account_ID="your-business-account-id"
SECURITY_WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
# App secret used to verify Meta WhatsApp webhook X-Hub-Signature-256 headers
WHATSAPP_APP_SECRET="your-meta-app-secret"
# Token you choose for the WhatsApp webhook verification handshake
WHATSAPP_VERIFY_TOKEN="your-webhook-verify-token"

# --- Redis (distributed session state, dedup, rate limiting) ---
REDIS_URL="redis://localhost:6379"
# Session TTL in seconds (SRS: 30 minutes)
SESSION_TTL_SECONDS=1800

# --- Text-to-Speech (TTS) provider ---
# One of: azure (default, best Arabic/compliance), elevenlabs, polly, edge, voicebox
TTS_PROVIDER="azure"
# Azure Neural TTS (recommended for Arabic/Levantine + banking compliance)
AZURE_TTS_KEY="your-azure-speech-key"
AZURE_TTS_REGION="westeurope"
AZURE_TTS_VOICE="ar-JO-TaimNeural"
# ElevenLabs (most natural; use Flash v2.5 for low-latency calls)
ELEVENLABS_VOICE_ID="your-elevenlabs-voice-id"
ELEVENLABS_MODEL="eleven_flash_v2_5"
# edge-tts dev server (local) / Voicebox (local GPU app)
EDGE_TTS_URL="http://localhost:5070"
VOICEBOX_URL="http://127.0.0.1:17493"
VOICEBOX_PROFILE_ID=""

# --- Private media storage + signed URLs (G27) ---
MEDIA_BUCKET="call-media"
SIGNED_URL_TTL_SECONDS=300

# --- Streaming voice / barge-in (G4, experimental) ---
VOICE_ASR_LANGUAGE="ar"
VOICE_ASR_MODEL="nova-2"
VOICE_SILENCE_TIMEOUT_MS=8000

# --- CORS / Security ---
# Comma-separated list of allowed browser origins (no wildcards in production)
# Note: the Vite dev server runs on port 8080 (see vite.config.ts).
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8080"
# Rate limits
RATE_LIMIT_IP_PER_MIN=60
RATE_LIMIT_SESSION_PER_MIN=10

# --- Runtime ---
NODE_ENV="development"
LOG_LEVEL="info"
# Expose /api/test/* (Backend Tester page) on a deployed/production backend.
# Leave false in real production; set true only for a demo/testing deployment.
ENABLE_TEST_ENDPOINTS="false"
